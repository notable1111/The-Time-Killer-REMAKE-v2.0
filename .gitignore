# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
*.log

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Recordings can get excessive in size
/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
__pycache__/

# Horror Sounds pack: the 22 tracks the game USES are committed via Git LFS
# (force-added past this rule). The rest (unauditioned tracks kept local for
# future layers) stays ignored — too big for the repo. Re-encode to OGG later
# to shrink the committed set. macOS junk + the unused Fantasy pack were trimmed.
/[Aa]ssets/[Rr]esources/[Oo]utsource/Horror Sounds/
/[Aa]ssets/[Rr]esources/[Oo]utsource/Horror Sounds.meta
/Clock.png

# Unity template leftovers. These reappear whenever a package is reimported.
# None of them is referenced by our code, scenes or ProjectSettings — the URP
# assets we actually use live in Assets/Resources/Assets/Rendering. Committing
# them means every teammate's Unity regenerates them slightly differently and
# the diff lands in the next pull as a conflict.
/[Aa]ssets/Settings/
/[Aa]ssets/Settings.meta
/[Aa]ssets/TutorialInfo/
/[Aa]ssets/TutorialInfo.meta
/[Aa]ssets/Readme.asset
/[Aa]ssets/Readme.asset.meta
/[Aa]ssets/InputSystem_Actions.inputactions
/[Aa]ssets/InputSystem_Actions.inputactions.meta
# TextMesh Pro essentials: 3.6 MB of package-owned files, and nothing in the
# project uses TMPro. Unity re-imports them on demand if we ever add TMP text.
/[Aa]ssets/TextMesh Pro/
/[Aa]ssets/TextMesh Pro.meta

# Editor screenshots from automated playtests — local debug output, not art.
/[Aa]ssets/Screenshots/
/[Aa]ssets/Screenshots.meta

# Map-pipeline backups (CastleWing.ldtk.pre-*.bak). Git is the backup.
*.bak
*.bak.meta

# Horror Engine (Retro Horror Template) — paid Asset Store asset, Unity EULA.
# Reference-only: we adapt IDEAS, never commit its source to the public repo.
# Kept at repo root (OUTSIDE Assets/) so Unity doesn't compile it — its scripts
# target old Cinemachine and break the build. Read it for patterns; don't import.
/_HorrorEngine_Reference/

# Bot playtest output. Data, not source: one file per batch, regenerated by
# TimeKiller/Setup/33. analyze.py reads whatever is here.
/Tools/Playtest/results/
